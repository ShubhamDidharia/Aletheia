# ─── Required ────────────────────────────────────────────────────────────────

# Google AI Studio -> https://aistudio.google.com/apikey
# Powers the Planner agent and the Analyst (contradiction detection).
GEMINI_API_KEY=

# Tavily -> https://app.tavily.com  (free tier: 1000 credits/month)
# The agent's web search tool.
TAVILY_API_KEY=

# ─── Recommended ─────────────────────────────────────────────────────────────

# Redis for the thought stream, execution checkpoints and search caching.
# Local:   redis://localhost:6379
# Upstash: rediss://default:<password>@<host>.upstash.io:6379
# If unreachable the app still runs, but degraded: state is lost on restart
# and it cannot scale past a single worker.
REDIS_URL=redis://localhost:6379

# ─── Optional ────────────────────────────────────────────────────────────────

GEMINI_MODEL=gemini-2.5-flash
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
