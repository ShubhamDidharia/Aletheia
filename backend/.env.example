# ─── Required ────────────────────────────────────────────────────────────────

# Google AI Studio -> https://aistudio.google.com/apikey
# Powers the Planner agent and the Analyst (contradiction detection).
GEMINI_API_KEY=

# Tavily -> https://app.tavily.com  (free tier: 1000 credits/month)
# The agent's web search tool.
TAVILY_API_KEY=

# ─── Recommended ─────────────────────────────────────────────────────────────

# Redis for the thought stream, execution checkpoints and search caching.
# Local:   redis://localhost:6379
# Upstash: rediss://default:<password>@<host>.upstash.io:6379
# If unreachable the app still runs, but degraded: state is lost on restart
# and it cannot scale past a single worker.
REDIS_URL=redis://localhost:6379

# ─── Optional: long-term memory (Commit 9) ───────────────────────────────────

# Persists finished missions, their sources and a pgvector embedding of the
# report, so past research can be searched semantically. Without these the app
# runs normally and simply doesn't store anything.
# Run backend/supabase_schema.sql in the Supabase SQL editor first.
# SUPABASE_URL is the same value as the frontend's NEXT_PUBLIC_SUPABASE_URL.
#
# The key is the SECRET one, not the publishable/anon key the frontend uses:
#   Project Settings -> API Keys -> "secret" (sb_secret_…)
#   older projects call it "service_role" (a long eyJ… JWT)
# Either env-var name below works. SERVER-SIDE ONLY — it bypasses Row Level
# Security, so it must never appear in a NEXT_PUBLIC_* var or in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=   # alias, if you prefer the newer naming

# ─── Optional ────────────────────────────────────────────────────────────────

GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
